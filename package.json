{
  "name": "nihongo-vocab-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev -p 3005 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit:copy": "node scripts/audit_copy.js",
    "split:chunks": "npx tsx scripts/split_vocab_chunks.ts",
    "enrich:export": "node scripts/export_enrichment_batch.js",
    "enrich:apply": "node scripts/apply_enrichment_batch.js",
    "validate:chunks": "node scripts/validate_chunks_strict.js",
    "validate:data": "python3 scripts/validate_vocab.py public/data/vocab_13000.json public/data/tranches.json && node scripts/validate_chunks_strict.js",
    "validate:agent-manifest": "node scripts/validate_agent_manifest.js",
    "audit:json-deps": "python3 scripts/audit_json_dependencies.py",
    "db:import:dry-run": "npx tsx scripts/import_vocab_to_db.ts --source=runtime-chunks --check-api-parity",
    "db:import": "npx tsx scripts/import_vocab_to_db.ts --source=runtime-chunks --check-api-parity --write",
    "validate:runtime-repository": "npx tsx scripts/validate_runtime_repository.ts",
    "related:candidates:sample": "python3 scripts/generate_related_candidates.py --limit 100 --top-k 5",
    "related:candidates:validate": "python3 scripts/validate_related_candidates.py scratch/vocab-db-migration/related_candidates.sample.jsonl"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.3.3",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
