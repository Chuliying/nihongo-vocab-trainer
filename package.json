{
  "name": "nihongo-vocab-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev -p 3005 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "split:chunks": "npx tsx scripts/split_vocab_chunks.ts",
    "enrich:export": "node scripts/export_enrichment_batch.js",
    "enrich:apply": "node scripts/apply_enrichment_batch.js",
    "validate:chunks": "node scripts/validate_chunks_strict.js",
    "validate:data": "python3 scripts/validate_vocab.py public/data/vocab_13000.json public/data/tranches.json && node scripts/validate_chunks_strict.js",
    "validate:agent-manifest": "node scripts/validate_agent_manifest.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
