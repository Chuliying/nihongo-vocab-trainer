{
  "name": "nihongo-vocab-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev -p 3005 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit:copy": "node scripts/audit_copy.js",
    "split:chunks": "npx tsx scripts/split_vocab_chunks.ts",
    "enrich:export": "node scripts/export_enrichment_batch.js",
    "enrich:apply": "node scripts/apply_enrichment_batch.js",
    "cleanup:manifest": ".venv/bin/python scripts/audit_example_target_tokens.py && node scripts/generate_cleanup_manifest.js",
    "cleanup:target-audit": ".venv/bin/python scripts/audit_example_target_tokens.py",
    "cleanup:manifest-routing": "node scripts/validate_cleanup_manifest_routing.js",
    "cleanup:legacy-meaning-gate": "node scripts/validate_legacy_meaning_gate.js",
    "cleanup:verbs": "node scripts/audit_verb_info.js",
    "cleanup:verb-quarantine": "node scripts/quarantine_bad_verb_info.js",
    "cleanup:verb-candidates": "node scripts/generate_verb_info_candidates.js",
    "cleanup:verb-apply": "node scripts/apply_verb_info_candidates.js",
    "cleanup:metadata": "node scripts/apply_metadata_only_cleanup.js",
    "cleanup:export": "node scripts/export_manifest_enrichment_batch.js",
    "cleanup:apply": "node scripts/apply_manifest_enrichment_patch.js",
    "cleanup:review-prepare": "node scripts/prepare_sparse_content_review.js",
    "cleanup:review-merge": "node scripts/merge_sparse_content_review.js",
    "validate:chunks": "node scripts/validate_chunks_strict.js",
    "validate:related": "node scripts/reconcile_related_words.js",
    "validate:data": "python3 scripts/validate_vocab.py public/data/vocab_13000.json public/data/tranches.json && node scripts/validate_chunks_strict.js && node scripts/reconcile_related_words.js",
    "validate:agent-manifest": "node scripts/validate_agent_manifest.js",
    "audit:json-deps": "python3 scripts/audit_json_dependencies.py",
    "db:import:dry-run": "npx tsx scripts/import_vocab_to_db.ts --source=runtime-chunks --check-api-parity",
    "db:import": "npx tsx scripts/import_vocab_to_db.ts --source=runtime-chunks --check-api-parity --write",
    "validate:runtime-repository": "npx tsx scripts/validate_runtime_repository.ts",
    "related:setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-related.txt",
    "related:candidates:sample": ".venv/bin/python scripts/generate_related_candidates.py --limit 100 --top-k 5",
    "related:candidates:validate": ".venv/bin/python scripts/validate_related_candidates.py scratch/vocab-db-migration/related_candidates.sample.jsonl",
    "related:sync": "node scripts/reconcile_related_words.js --write",
    "cleanup:strip-drift": "node scripts/strip_unrequired_drift.js",
    "examples:real:candidates": ".venv/bin/python scripts/select_real_examples.py",
    "examples:real:enrich": ".venv/bin/python scripts/enrich_real_example_candidates.py",
    "examples:real:prepare-review": ".venv/bin/python scripts/prepare_real_example_review.py",
    "examples:real:normalize-review": ".venv/bin/python scripts/normalize_real_example_review_draft.py",
    "examples:real:validate": ".venv/bin/python scripts/validate_real_example_candidates.py",
    "examples:real:apply": "node scripts/apply_real_example_patch.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.3.3",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
