# Vocabulary DB migration.
# Phase 1 defaults to JSON-backed runtime while DB import/parity is developed.
VOCAB_DATA_SOURCE=json

# Preferred provider: Neon Postgres.
# Example shape:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Import source can be canonical or runtime-chunks.
# runtime-chunks is the current app source-of-truth per CLAUDE.md and lib/vocab-data.ts.
# canonical: public/data/vocab_13000.json
# runtime-chunks: public/data/chunks/vocab_chunk_*.json
VOCAB_DB_IMPORT_SOURCE=runtime-chunks
